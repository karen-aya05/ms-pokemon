{
  "name": "lda-create-pokemon",
  "version": "1.0.0",
  "description": "Lambda to create Pokémon ",
  "main": "index.js",
  "scripts": {
    "test": "env-cmd -f ./test/.env-example mocha -t 15000 --recursive --reporter=spec",
    "test:coverage": "env-cmd -f ./test/.env-example nyc --reporter=lcov --reporter=text mocha -t 15000 --recursive --reporter=spec",
    "install:dev": "rm -rf node_modules/ && npm install",
    "install:prod": "rm -rf node_modules/ && npm install --only=prod",
    "eslint": "standard --fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.9.0",
    "bent": "^7.3.12",
    "eslint": "^6.8.0",
    "joi": "^17.13.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "aws-sdk": "^2.1692.0",
    "chai": "^4.2.0",
    "dotenv": "^8.2.0",
    "env-cmd": "^10.1.0",
    "mocha": "^8.1.3",
    "mocha-junit-reporter": "^2.2.0",
    "nock": "^13.2.1",
    "nyc": "^15.1.0",
    "sinon": "^9.0.3",
    "standardx": "^5.0.0"
  },
  "standardx": {
    "env": [
      "mocha"
    ],
    "globals": [
      "beforeEach",
      "afterEach",
      "describe",
      "it"
    ]
  },
  "eslintConfig": {
    "extends": "standardx",
    "rules": {
      "comma-dangle": [
        "error",
        "always"
      ]
    }
  },
  "nyc": {
    "all": true,
    "check-coverage": false,
    "include": [
      "src/**/*.js",
      "common/**/*.js",
      "index.js"
    ],
    "exclude": [
      "common/config/**",
      "test/**",
      "node_modules/**"
    ],
    "reporter": [
      "text",
      "text-summary",
      "lcov",
      "cobertura"
    ]
  }
}
